# Copy this file to `.env` next to compose.yaml and fill it in
# (`cp .env.example docker/.env` in this repo). Compose reads that one file for
# the ${...} substitutions in compose.yaml and as the app's environment.

# Database password for the bundled Postgres (compose only). It is embedded in
# DATABASE_URL, so it must be URL-safe: openssl rand -hex 24
# Left empty on purpose: compose refuses to start until you set it.
POSTGRES_PASSWORD=

# Password of belay_app, the database role the app connects as; the owner above
# only runs the migrations at startup. URL-safe as well: openssl rand -hex 24
# Left empty on purpose: compose refuses to start until you set it.
BELAY_APP_PASSWORD=

# Where people reach Belay. https in production: it enables secure, __Host- cookies and HSTS.
PUBLIC_URL=https://belay.example.org

# Any standard OpenID Connect provider (Keycloak, Authentik, Pocket ID…).
# Register a confidential client with redirect URI ${PUBLIC_URL}/auth/callback
# and post-logout redirect URI ${PUBLIC_URL}/.
OIDC_ISSUER=https://id.example.org/realms/main
OIDC_CLIENT_ID=belay
OIDC_CLIENT_SECRET=change-me
# Claim used as display name; falls back to preferred_username.
OIDC_NAME_CLAIM=name

# At least 32 random characters: openssl rand -hex 32
# It also keys the stored session hashes: changing it signs everyone out.
# Left empty on purpose: the app refuses to boot until you set it.
SESSION_SECRET=
# A session lasts SESSION_TTL_DAYS after its last use, and never more than
# SESSION_MAX_DAYS after sign-in, however active (at least SESSION_TTL_DAYS).
SESSION_TTL_DAYS=30
SESSION_MAX_DAYS=90
