{
  "name": "@belay/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "esbuild src/main.ts src/admin.ts --bundle --platform=node --target=node24 --format=esm --outdir=dist --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@belay/shared": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "openid-client": "^6.9.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oauth2-mock-server": "^9.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
