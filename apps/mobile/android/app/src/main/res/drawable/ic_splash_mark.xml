<?xml version="1.0" encoding="utf-8"?>
<!-- The splash's mark, the ring in ink and the mountain in blue, as the page's launch draws it in the light theme. The
     canvas is the adaptive icon's 108 units at the splash's 288 dp, and the mark is placed as the
     launcher foreground places it, so the page's launch takes over without a jump. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The 100-unit mark, one unit lower, centred on the canvas. -->
    <group
        android:scaleX="0.47975625"
        android:scaleY="0.47975625"
        android:translateX="30.0121875"
        android:translateY="30.49194375">
        <path
            android:pathData="M28.6 78.8 A37 37 0 1 1 71.4 78.8"
            android:strokeColor="#12181C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M28.6 78.8 L39 58 L45 64 L56 44 L71.4 78.8"
            android:strokeColor="#1F4E8C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
