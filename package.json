{
  "name": "belay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --check --ignore-unknown",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --write --ignore-unknown",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "size": "size-limit",
    "e2e": "pnpm --filter @belay/web e2e",
    "science:doc": "tsx scripts/science-doc.ts",
    "science:check": "tsx scripts/science-doc.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.1.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "size-limit": "^14.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
