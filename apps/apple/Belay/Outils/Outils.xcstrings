    "Dans %lld à %lld semaines. La perte ralentit à mesure que tu perds du poids, d’où une fourchette.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %lld to %lld weeks. Loss slows down as you lose weight, hence a range."
