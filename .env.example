# Database password for the bundled Postgres (compose only).
POSTGRES_PASSWORD=change-me

# Where people reach Belay. https in production: it enables secure, __Host- cookies and HSTS.
PUBLIC_URL=https://belay.example.org

# Any standard OpenID Connect provider (Keycloak, Authentik, Pocket ID…).
# Register a confidential client with redirect URI ${PUBLIC_URL}/auth/callback
# and post-logout redirect URI ${PUBLIC_URL}/.
OIDC_ISSUER=https://id.example.org/realms/main
OIDC_CLIENT_ID=belay
OIDC_CLIENT_SECRET=change-me
# Claim used as display name; falls back to preferred_username.
OIDC_NAME_CLAIM=name

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=30
